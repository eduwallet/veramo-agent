  "files": [
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 18.0.0"
  },
  "prettier": {
    "endOfLine": "auto",
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
