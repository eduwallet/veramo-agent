    "**/@veramo/core": "4.2.0",
    "**/@veramo/utils": "4.2.0",
    "**/@veramo/key-manager": "4.2.0",
    "**/@veramo/did-manager": "4.2.0",
    "**/@veramo/did-discovery": "4.2.0",
