    "@sphereon/ssi-sdk-ext.did-resolver-jwk": "0.23.0",
    "@sphereon/ssi-sdk-ext.did-utils": "0.24.0",
    "@sphereon/ssi-sdk-ext.key-utils": "0.24.0",
    "@sphereon/ssi-sdk.vc-handler-ld-local": "0.29.0",
    "@transmute/did-key.js": "^0.3.0-unstable.10",
    "@veramo/core": "4.2.0",
    "@veramo/credential-ld": "4.2.0",
    "@veramo/credential-w3c": "4.2.0",
    "@veramo/data-store": "4.2.0",
    "@veramo/did-discovery": "4.2.0",
    "@veramo/did-jwt": "4.2.0",
    "@veramo/did-manager": "4.2.0",
    "@veramo/did-provider-key": "4.2.0",
    "@veramo/did-provider-web": "4.2.0",
    "@veramo/did-resolver": "4.2.0",
    "@veramo/key-manager": "4.2.0",
    "@veramo/kms-local": "4.2.0",
    "cliui": "7.0.0",
    "debug": "4.3.5",
    "did-jwt": "^7.4.7",
    "dotenv-flow": "^4.1.0",
    "express": "^4.19.2",
    "jose": "^6.0.10",
    "jsonld": "5.2.0",
