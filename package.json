  "dependencies": {
    "@muisit/cryptokey": "1.2.2",
    "@sd-jwt/core": "^0.9.2",
    "@sd-jwt/crypto-nodejs": "^0.9.2",
    "@sd-jwt/sd-jwt-vc": "^0.9.2",
    "body-parser": "^2.2.0",
    "cbor2": "^2.0.1",
    "cors": "^2.8.5",
    "debug": "4.3.5",
    "dotenv-flow": "^4.1.0",
    "express": "^5.1.0",
    "jose": "^6.0.10",
    "jsonld": "8.3.3",
    "jsonld-signatures": "11",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "patch-package": "^8.0.0",
