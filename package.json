{
  "name": "veramo-agent",
  "version": "1.0.0",
  "description": "Veramo agent",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:clean": "tsc --build --clean && tsc --build",
    "start:prod": "node --experimental-specifier-resolution=node --loader ts-node/esm dist/main.js",
    "start:dev": "tsx --watch src/main.ts",
    "cli": "tsx src/cli.ts",
    "postinstall": "patch-package",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [],
  "author": "Michiel Uitdehaag <info@muisit.nl>",
  "license": "Apache-2.0",
  "private": false,
  "dependencies": {
    "@muisit/cryptokey": "^1.1.1",
    "@sd-jwt/core": "^0.9.2",
    "@sd-jwt/crypto-nodejs": "^0.9.2",
    "@sd-jwt/sd-jwt-vc": "^0.9.2",
    "@sphereon/ssi-express-support": "0.29.0",
    "@sphereon/ssi-sdk-ext.did-utils": "0.24.0",
    "@sphereon/ssi-sdk-ext.key-utils": "0.24.0",
    "@sphereon/ssi-sdk.vc-handler-ld-local": "0.29.0",
    "@veramo/core": "6.0.0",
    "@veramo/credential-ld": "6.0.0",
    "@veramo/credential-w3c": "6.0.0",
    "@veramo/data-store": "6.0.0",
    "@veramo/did-discovery": "6.0.0",
    "@veramo/did-jwt": "6.0.0",
    "@veramo/did-manager": "6.0.0",
    "@veramo/did-resolver": "6.0.0",
    "debug": "4.3.5",
    "did-jwt": "^7.4.7",
    "dotenv-flow": "^4.1.0",
    "express": "^4.19.2",
    "jose": "^6.0.10",
    "jsonld": "5.2.0",
    "jwt-decode": "4",
    "moment": "^2.30.1",
    "passport-http-bearer": "^1.0.1",
    "patch-package": "^8.0.0",
    "pg": "^8.12.0",
    "postinstall": "^0.10.3",
    "string-width": "^4.2.3",
    "tsconfig-paths": "^4.2.0",
    "uint8arrays": "^5.1.0",
    "uuid": "^11.1.0"
  },
  "files": [
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 18.0.0"
  },
  "prettier": {
    "endOfLine": "auto",
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "pnpm": {
    "patchedDependencies": {
      "did-jwt@6.11.6": "patches/did-jwt@6.11.6.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/passport": "^1.0.16",
    "@types/passport-http-bearer": "^1.0.41",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "prettier": "^3.5.3",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "2.1.5"
  },
  "imports": {
    "#root/*": "./src/*.ts"
  },
  "packageManager": "yarn@1.22.22"
}
